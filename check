#!/usr/bin/env bash
# ./check            -> all tests
# ./check 01         -> module 01 only
# ./check 01 two_sum -> one problem
set -u
cd "$(dirname "$0")"
if [ $# -eq 0 ]; then
  exec python3 -m pytest
elif [ $# -eq 1 ]; then
  f=$(ls tests/test_$1_*.py 2>/dev/null | head -1)
  [ -z "$f" ] && { echo "no test file for module $1"; exit 1; }
  exec python3 -m pytest "$f"
else
  f=$(ls tests/test_$1_*.py 2>/dev/null | head -1)
  [ -z "$f" ] && { echo "no test file for module $1"; exit 1; }
  exec python3 -m pytest "$f" -k "$2"
fi
